---
import "../styles/global.css";
import SEO from "../components/SEO.astro";

interface SEOProps {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  type?: string;
  noindex?: boolean;
}

interface Props {
  restaurantName: string;
  /** @deprecated Usa seo.title */
  pageTitle?: string;
  seo?: SEOProps;
}

const { restaurantName, pageTitle, seo = {} } = Astro.props;

const defaultTitle = pageTitle ?? seo.title ?? restaurantName;
const defaultDescription =
  seo.description ??
  'Restaurante en El Bonillo (Albacete). Tapas, pizzas artesanas, hamburguesas y menús de fin de semana. Cocina tradicional hecha con producto fresco y mucho cariño.';

// TODO: actualizar con la URL real del sitio cuando esté en producción
const SITE_URL = 'https://elrincondehector.com';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'El Rincón de Héctor',
  url: SITE_URL,
  telephone: '+34967370582',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Calle Calderas, 4',
    addressLocality: 'El Bonillo',
    addressRegion: 'Castilla-La Mancha',
    postalCode: '02610',
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 38.9504, 
    longitude: -2.5382,
  },
  servesCuisine: ['Española', 'Tapas', 'Pizzas', 'Hamburguesas'],
  menu: `${SITE_URL}/carta`,
  priceRange: '€€',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Thursday'],
      opens: '20:00',
      closes: '00:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
      opens: '13:00',
      closes: '00:00',
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={defaultTitle}
      description={defaultDescription}
      image={seo.image}
      url={seo.url}
      type={seo.type}
      noindex={seo.noindex}
    />

    <!-- Rendimiento: preconexión a fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Jost:wght@400;500;600&display=swap"
    />

    <!-- Datos estructurados JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot name="hero" />
      <slot name="showcase" />
      <slot name="about" />
      <slot name="reviews" />
      <slot name="reservations" />
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<script>
  import '../scripts/lenis.js';
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  main {
    flex-grow: 1;
  }
</style>
