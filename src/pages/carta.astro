  name: string;
  description: string;
  price: string;
}

interface Drink {
  name: string;
  price: string;
}

interface MenuCourse {
  label: string;
  options: string[];
}

interface WeekendMenu {
  name: string;
  courses: MenuCourse[];
  price: string;
  note: string;
}

interface Tab {
  id: string;
  label: string;
  icon: string;
}

