---

<Layout restaurantName="El Rincón de Héctor" pageTitle="La Carta — El Rincón de Héctor">
  <Header slot="header" elements={headerElements} />

  <Fragment>
      <!-- Encabezado de página -->
      <section class="pt-32 pb-10 px-6">
        <div class="max-w-4xl mx-auto">
          <p class="eyebrow">El Rincón de Héctor</p>
          <h1 class="page-title">La Carta</h1>
          <p class="page-subtitle">Producto fresco, cocina con cariño y sabores de siempre</p>
        </div>
      </section>

      <!-- Navegación por pestañas -->
      <div class="sticky top-16 z-40 px-6 tab-nav-bar">
        <div class="max-w-4xl mx-auto overflow-x-auto">
          <nav class="flex whitespace-nowrap" id="tab-nav" role="tablist">
            {tabs.map((tab, i) => (
              <button
                class:list={['tab-btn', i === 0 ? 'tab-active' : '']}
                data-tab={tab.id}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={tab.id}
              >
                <Icon name={tab.icon} class="tab-icon" />
                <span>{tab.label}</span>
              </button>
            ))}
          </nav>
        </div>
      </div>

      <!-- Contenido de las pestañas -->
      <div class="max-w-4xl mx-auto px-6 py-12">

        <!-- TAPAS -->
        <section id="tapas" class="tab-section" role="tabpanel">
          <div class="mb-12">
                <p class="category-label">Calientes</p>
                <div class="dish-list">
                {tapasCalientes.map(dish => (
                    <div class="dish-row">
                    <div class="dish-info">
                        <div class="flex items-center gap-2 flex-wrap">
                        <span class="dish-name">{dish.name}</span>
                        {dish.badge === 'popular' && <span class="badge badge-popular">Popular</span>}
                        {dish.badge === 'new' && <span class="badge badge-new">Nuevo</span>}
                        </div>
                        <p class="dish-desc">{dish.description}</p>
                    </div>
                    <span class="dish-price">{dish.price}</span>
                    </div>
                ))}
                </div>
          </div>
          <div>
            <p class="category-label">Frías</p>
            <div class="dish-list">
              {tapasFrias.map(dish => (
                <div class="dish-row">
                  <div class="dish-info">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="dish-name">{dish.name}</span>
                      {dish.badge === 'popular' && <span class="badge badge-popular">Popular</span>}
                      {dish.badge === 'new' && <span class="badge badge-new">Nuevo</span>}
                    </div>
                    <p class="dish-desc">{dish.description}</p>
                  </div>
                  <span class="dish-price">{dish.price}</span>
                </div>
              ))}
            </div>
          </div>

        </section>

        <!-- PIZZAS -->
        <section id="pizzas" class="tab-section hidden" role="tabpanel">
          <div class="chef-note mb-10">
            <p>
             Todas nuestras pizzas se elaboran con masa madre de fermentación lenta (72 h)
              y se hornean en horno de leña a 450 °C.
            </p>
            <p>
              Precio único: <strong>12,00 €</strong>. 
            </p>
          </div>

          <div class="dish-list">
            {pizzas.map(dish => (
              <div class="dish-row">
                <div class="dish-info">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="dish-name">{dish.name}</span>
                    {dish.badge === 'popular' && <span class="badge badge-popular">Popular</span>}
                    {dish.badge === 'new' && <span class="badge badge-new">Nuevo</span>}
                  </div>
                  <p class="dish-desc">{dish.description}</p>
                </div>
                <span class="dish-price">{dish.price}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- HAMBURGUESAS & BOCADILLOS -->
        <section id="hamburguesas" class="tab-section hidden" role="tabpanel">
          <div class="mb-12">
            <p class="category-label">Hamburguesas</p>
            <div class="dish-list">
              {hamburguesas.map(dish => (
                <div class="dish-row">
                  <div class="dish-info">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="dish-name">{dish.name}</span>
                      {dish.badge === 'popular' && <span class="badge badge-popular">Popular</span>}
                      {dish.badge === 'new' && <span class="badge badge-new">Nuevo</span>}
                    </div>
                    <p class="dish-desc">{dish.description}</p>
                  </div>
                  <span class="dish-price">{dish.price}</span>
                </div>
              ))}
            </div>
          </div>

          <div>
            <p class="category-label">Tostas</p>
            <div class="dish-list">
              {bocadillos.map(dish => (
                <div class="dish-row">
                  <div class="dish-info">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="dish-name">{dish.name}</span>
                      {dish.badge === 'popular' && <span class="badge badge-popular">Popular</span>}
                      {dish.badge === 'new' && <span class="badge badge-new">Nuevo</span>}
                    </div>
                    <p class="dish-desc">{dish.description}</p>
                  </div>
                  <span class="dish-price">{dish.price}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- MENÚ FIN DE SEMANA -->
        <section id="menu-fds" class="tab-section hidden" role="tabpanel">
          <div class="mb-10">
            <p class="eyebrow">Solo sábados y domingos · disponible de 13:00 a 16:30</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
            {weekendMenus.map(menu => (
              <div class="menu-card">
                <h3 class="menu-card-title">{menu.name}</h3>
                <div class="flex-1">
                  {menu.courses.map(course => (
                    <div class="mb-5">
                      <p class="category-label">{course.label}</p>
                      <ul class="menu-options">
                        {course.options.map(opt => (
                          <li class="menu-option">{opt}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                <div class="menu-card-footer">
                  <p class="menu-note">{menu.note}</p>
                  <p class="menu-price">{menu.price} <span class="menu-price-label">por persona</span></p>
                </div>
              </div>
            ))}
          </div>
          <div class="chef-note">
            <p>El menú cambia cada fin de semana según el mercado.</p>
          </div>
        </section>

        <!-- BODEGA -->
        <section id="bodega" class="tab-section hidden" role="tabpanel">
          <div class="mb-12">
            <p class="category-label">Vinos blancos</p>
            <div class="wine-grid">
              {vinosBlancos.map(wine => (
                <div class="wine-card">
                  <div>
                    <p class="wine-name">{wine.name}</p>
                    {wine.region && <p class="wine-region">{wine.region}{wine.grapes ? ` · ${wine.grapes}` : ''}</p>}
                  </div>
                  <div class="wine-prices">
                    {wine.copa && <span>Copa <strong>{wine.copa}</strong></span>}
                    <span>Botella <strong>{wine.botella}</strong></span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="mb-8">
            <p class="category-label">Vinos tintos · El Bonillo</p>
            <div class="wine-grid">
              {vinosTintosElBonillo.map(wine => (
                <div class="wine-card">
                  <div>
                    <p class="wine-name">{wine.name}</p>
                    {wine.region && <p class="wine-region">{wine.region}{wine.grapes ? ` · ${wine.grapes}` : ''}</p>}
                  </div>
                  <div class="wine-prices">
                    {wine.copa && <span>Copa <strong>{wine.copa}</strong></span>}
                    <span>Botella <strong>{wine.botella}</strong></span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="mb-12">
            <p class="category-label">Vinos tintos · D.O. Ribera del Duero</p>
            <div class="wine-grid">
              {vinosTintosRibera.map(wine => (
                <div class="wine-card">
                  <div>
                    <p class="wine-name">{wine.name}</p>
                    {wine.region && <p class="wine-region">{wine.region}{wine.grapes ? ` · ${wine.grapes}` : ''}</p>}
                  </div>
                  <div class="wine-prices">
                    {wine.copa && <span>Copa <strong>{wine.copa}</strong></span>}
                    <span>Botella <strong>{wine.botella}</strong></span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="mb-12">
            <p class="category-label">Rosados y espumosos</p>
            <div class="wine-grid">
              {vinosRosadosEspumosos.map(wine => (
                <div class="wine-card">
                  <div>
                    <p class="wine-name">{wine.name}</p>
                    {wine.region && <p class="wine-region">{wine.region}{wine.grapes ? ` · ${wine.grapes}` : ''}</p>}
                  </div>
                  <div class="wine-prices">
                    {wine.copa && <span>Copa <strong>{wine.copa}</strong></span>}
                    <span>Botella <strong>{wine.botella}</strong></span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="mb-12">
            <p class="category-label">Cervezas</p>
            <div class="dish-list">
              {cervezas.map(beer => (
                <div class="dish-row">
                  <div class="dish-info">
                    <span class="dish-name">{beer.name}</span>
                    <p class="dish-desc">{beer.description}</p>
                  </div>
                  <span class="dish-price">{beer.price}</span>
                </div>
              ))}
            </div>
          </div>

          <div>
            <p class="category-label">Refrescos y agua</p>
            <div class="dish-list">
              {refrescos.map(drink => (
                <div class="dish-row">
                  <div class="dish-info">
                    <span class="dish-name">{drink.name}</span>
                  </div>
                  <span class="dish-price">{drink.price}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

      </div>
  </Fragment>

  <Footer
    slot="footer"
    socialElements={footerSocial}
    restaurantName="El Rincón de Héctor"
  />
</Layout>

