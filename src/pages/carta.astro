---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { headerElements, footerSocial } from '../data/nav';

interface Dish {
  name: string;
  description: string;
  price: string;
  badge?: 'popular' | 'new';
}

interface WineCard {
  name: string;
  region?: string;
  grapes?: string;
  copa?: string;
  botella: string;
}

interface Beer {
  name: string;
  price: string;
}

interface Drink {
  name: string;
  price: string;
}

interface MenuCourse {
  label: string;
  options: string[];
}

interface WeekendMenu {
  name: string;
  courses: MenuCourse[];
  price: string;
  note: string;
}

interface Tab {
  id: string;
  label: string;
  icon: string;
}

