---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import BurgerScroll from '../components/BurgerScroll.astro';
import Footer from '../components/Footer.astro';
import About from '../components/About.astro';
import Reservations from '../components/Reservations.astro';
import Gallery from '../components/Gallery.astro';
import Reviews from '../components/Reviews.astro';
import { headerElements, footerSocial } from '../data/nav';
---

<Layout
	restaurantName="El Rincón de Héctor"
	seo={{
		title: 'El Rincón de Héctor | Restaurante en El Bonillo, Albacete',
		description: 'Restaurante en El Bonillo (Albacete). Tapas, pizzas artesanas de horno de leña, hamburguesas y menús de fin de semana. Cocina tradicional con producto fresco. Reservas: 967 37 05 82.',
	}}
>
	<Header slot="header" elements={headerElements}/>
	<Hero slot="hero"
		title="El Rincón de Héctor"
		subtitle="Tu lugar para desconectar y comer como en casa. Prueba nuestras recetas únicas en un ambiente acogedor y cercano."
		cta={{
			label: 'Reservar mesa',
			link: '/#reservas',
			icon: 'lucide:calendar',
		}}
		secondaryCta={{
			label: 'Ver la carta',
			link: '/carta',
			icon: 'lucide:book-open',
		}}
	/>
	<BurgerScroll slot="showcase" />
	<About slot="about"
		eyebrow="Nuestra casa"
		title="Un rincón con sabor a hogar"
		description="El Rincón de Héctor nació del deseo de ofrecer cocina tradicional hecha con producto fresco de temporada y mucho cariño. Ven a disfrutar y a compartir momentos con los tuyos."
		kpis={[
			{
				icon: 'lucide:map-pin',
				label: 'Ubicación',
				value: 'Calle Calderas, 4 · 02610 El Bonillo (Albacete)',
			},
			{
				icon: 'lucide:clock',
				label: 'Horario',
				value: [
					'Viernes · 20:00 – 23:00 h',
					'Sáb y Dom · 12:00 – 16:00 / 20:00 – 23:00 h',
				],
			},
			{
				icon: 'lucide:pizza',
				label: 'Platos Destacados',
				value: 'Pizzas caseras y Hamburguesas especiales'
			},
			{
				icon: 'lucide:handbag',
				label: 'Para llevar',
				value: 'Gran variedad de platos para compartir en casa',
			}
		]}
	/>
	<Gallery slot="gallery" />
	<Reviews slot="reviews"
		eyebrow="Reseñas y comentarios"
		title="Opiniones de nuestros clientes"
		subtitle="Más de 8 años entre los fogones con la misma ilusión de siempre. Esto es lo que dicen quienes ya han pasado por nuestra mesa."
		averageRating={4.3}
		totalReviews={310}
		reviews={[
			{
				name: 'Mari Carmen P.',
				rating: 4,
				text: 'Muy recomendado, hay gran variedad y está todo excelente. Los menús son muy innovadores y sobre todo a buen precio. Todos los productos de gran calidad y muy bien tratados en cocina.',
				date: 'Abr 2024',
				platform: 'google',
			},
			{
				name: 'Lola M.',
				rating: 5,
				text: 'Una vez mas espectacular. Comida deliciosa y un trato muy agradable. Visita obligatoria cada vez que nos pilla de camino',
				date: 'Mar 2023',
				platform: 'google',
			},
			{
				name: 'Anais N.',
				rating: 5,
				text: 'Magnífico restaurante. Comida de muy buena calidad y el personal muy atento. Los menús del día están muy bien relación calidad precio. Somos clientes habituales y siempre volvemos! Muy recomendable para celebraciones y reservas grandes . La terraza interior preciosa!',
				date: 'Feb 2024',
				platform: 'google',
			},
			{
				name: 'Luis C.',
				rating: 4,
				text: 'Todo muy bueno y nada caro. Las camareras atentísimas. Un gusto!',
				date: 'Ene 2025',
				platform: 'google',
			},
			{
				name: 'Cristina R.',
				rating: 5,
				text: 'Fuimos a cenar toda la familia. El servicio muy atento y la cena riquísima, pedimos croquetas que estaban deliciosas unas de jamón y otras de gambas, las recomiendo 100%, también el solomillo y por supuesto las pizzas. Volveremos.',
				date: 'Dic 2024',
				platform: 'google',
			},
			{
				name: 'Marcos R.',
				rating: 5,
				text: 'Se come genial aquí, recomiendo encarecidamente reservar previamente por que suele estar muy lleno, sobre todo en fines de semana, pero cada fin de semana tienes para elegir un menú diferente y está todo riquísimo.',
				date: 'Nov 2024',
				platform: 'google',
			},
			{
				name: 'David C.',
				rating: 5,
				text: 'Un buen sitio para comer de forma tranquila y pausada. Y sin prisas, cada plato muy bueno y un descubrimiento. Quedan pendientes las pizzas.',
				date: 'Oct 2025',
				platform: 'google',
			},
			{
				name: 'David L.',
				rating: 4,
				text: 'Buena opción para comer en El Bonillo. Las hamburguesas son muy buenas y las raciones son generosas. Lo recomiendo a todo el que pase por la zona.',
				date: 'Ene 2026',
				platform: 'google',
			},
		]}
	/>
	<Reservations slot="reservations"
		eyebrow="Reservas"
		title="¿Quieres reservar o encargar tu pedido?"
		description="Puedes llamarnos o escribirnos por WhatsApp y te confirmamos disponibilidad enseguida. También puedes pasarte directamente por el local."
		phone="967 37 05 82"
		whatsapp="+34619574682"
		callSchedule={[
			'Viernes · 20:00 – 23:00 h',
			'Sáb y Dom · 12:00 – 16:00 / 20:00 – 23:00 h',
		]}
		address="Calle Calderas, 4"
		city="02610 El Bonillo (Albacete)"
		mapsUrl="https://maps.app.goo.gl/FhWj4s6dDa92pkKx5"
	/>
	<Footer slot="footer"
		socialElements={footerSocial}
		restaurantName="El Rincón de Héctor"
	/>
</Layout>
