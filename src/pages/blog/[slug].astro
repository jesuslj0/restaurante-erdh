---
// ============================================================
//  /blog/<slug> — una entrada
// ------------------------------------------------------------
//  Una página por cada .md de src/content/blog, generada en el
//  build. El slug es el nombre del archivo.
// ============================================================
import '../../styles/blog.css';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { headerElements, footerSocial, contactPhone } from '../../data/nav';
import { HORARIO, TELEFONO, TELEFONO_TEL } from '../../data/negocio';
import { fechaISO, fechaLarga, tituloSEO } from '../../lib/blog';
import { publicados, relacionados, type Post } from '../../lib/blog-posts';

export async function getStaticPaths() {
  const posts = await publicados();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}

const { post, posts } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const otras = relacionados(posts, post, 2);

const site = (Astro.site ?? Astro.url).origin;
// Con barra final, igual que el canonical que genera el build (/carta/, /blog/x/).
const url = `${site}/blog/${post.id}/`;

// La portada para WhatsApp, Facebook y Google: jpg de 1200, que es lo que
// todos aceptan sin sorpresas.
const og = await getImage({ src: data.imagen, width: 1200, format: 'jpg' });
const ogAbs = new URL(og.src, site).href;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.titulo,
    description: data.descripcion,
    image: ogAbs,
    datePublished: fechaISO(data.fecha),
    dateModified: fechaISO(data.actualizado ?? data.fecha),
    mainEntityOfPage: url,
    inLanguage: 'es-ES',
    author: { '@type': 'Organization', name: 'El Rincón de Héctor', url: site },
    publisher: { '@type': 'Organization', name: 'El Rincón de Héctor', url: site },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog/` },
      { '@type': 'ListItem', position: 3, name: data.titulo, item: url },
    ],
  },
];
---

<Layout
  restaurantName="El Rincón de Héctor"
  seo={{ title: tituloSEO(data.titulo), description: data.descripcion, image: ogAbs, type: 'article' }}
>
  <Header slot="header" elements={headerElements} phone={contactPhone} socialElements={footerSocial} />

  <article>
    <header class="blog-head px-6 pt-32 pb-24">
      <div class="mx-auto max-w-[52rem]">
        <nav class="blog-migas mb-6" aria-label="Migas de pan">
          <a href="/">Inicio</a><span aria-hidden="true">/</span>
          <a href="/blog">Blog</a><span aria-hidden="true">/</span>
          <span aria-current="page">{data.categoria}</span>
        </nav>
        <span class="blog-cat">{data.categoria}</span>
        <h1 class="mt-4 font-display text-4xl leading-[1.08] font-bold text-primary md:text-6xl">{data.titulo}</h1>
        <p class="mt-5 text-lg text-text-accent/90">{data.descripcion}</p>
        <p class="mt-6 flex flex-wrap gap-2 text-xs text-secondary/65">
          <time datetime={fechaISO(data.fecha)}>{fechaLarga(data.fecha)}</time>
          <span aria-hidden="true">·</span>
          <span>{post.lectura} min de lectura</span>
          {
            data.actualizado && (
              <>
                <span aria-hidden="true">·</span>
                <span>Actualizado el {fechaLarga(data.actualizado)}</span>
              </>
            )
          }
        </p>
      </div>
    </header>

    {/* La portada mide lo mismo que la columna de texto y sube sobre la
        cabecera: presenta el artículo en vez de taparlo. */}
    <figure class="mx-auto -mt-14 max-w-[52rem] px-6">
      <Image
        src={data.imagen}
        alt={data.imagen_alt}
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 900px) 100vw, 832px"
        loading="eager"
        fetchpriority="high"
        class="aspect-[16/9] w-full rounded-md border border-primary/10 object-cover shadow-2xl shadow-black/60"
      />
    </figure>

    <div class="blog-prose mx-auto max-w-[52rem] px-6 pt-12">
      <Content />
    </div>

    <aside class="mx-auto mt-16 max-w-[52rem] px-6">
      <div class="blog-cta flex flex-col items-center gap-4 rounded-md px-6 py-10 text-center md:px-10">
        <p class="text-xs font-medium tracking-[0.18em] text-accent uppercase">Reserva o encarga</p>
        <h2 class="font-display text-3xl leading-tight font-bold text-primary md:text-4xl">Te esperamos en la Calle Calderas</h2>
        <p class="max-w-lg text-secondary">
          Para reservar mesa o pedir para llevar, llámanos. Los pedidos se recogen en el local.
        </p>
        <ul class="flex flex-col gap-1 text-sm text-text-accent">
          {HORARIO.map((h) => <li>{h}</li>)}
        </ul>
        <div class="mt-2 flex flex-wrap justify-center gap-3">
          <a href={`tel:${TELEFONO_TEL}`} class="btn-primary">
            <Icon name="lucide:phone" class="size-4" />
            Llamar al {TELEFONO}
          </a>
          <a href="/carta" class="btn-secondary">
            <Icon name="lucide:book-open" class="size-4" />
            Ver la carta
          </a>
        </div>
      </div>
    </aside>
  </article>

  {
    otras.length > 0 && (
      <section class="mx-auto max-w-[52rem] px-6 py-20">
        <p class="mb-2 text-xs font-medium tracking-[0.18em] text-accent uppercase">Sigue leyendo</p>
        <h2 class="mb-8 font-display text-3xl font-bold text-primary">Más del Rincón</h2>
        <div class="grid gap-6 sm:grid-cols-2">
          {otras.map((p) => (
            <PostCard post={p} as="h3" />
          ))}
        </div>
      </section>
    )
  }

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemas)} />

  <Footer slot="footer" socialElements={footerSocial} restaurantName="El Rincón de Héctor" />
</Layout>
