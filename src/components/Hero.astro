---
import { Icon } from 'astro-icon/components';


interface Cta {
	label: string
	link: string
	icon: string
}

type Props = {
	title: string
	subtitle?: string
	cta?: Cta
	secondaryCta?: Cta
}

const { title, subtitle, cta, secondaryCta } = Astro.props
---

<section class="hero-section bg-stone-200 min-h-[80vh] h-screen flex items-center justify-center px-6 py-20">
	<div class="background-overlay"></div>
	<div class="text-center max-w-2xl mx-auto flex flex-col items-center gap-6 z-10">
		<h1 class="text-5xl font-bold tracking-tight text-primary sm:text-6xl">
			{title}
		</h1>
		{subtitle && (
			<p class="text-lg text-accent max-w-prose">
				{subtitle}
			</p>
		)}
		{(cta || secondaryCta) && (
			<div class="flex flex-wrap gap-3 justify-center mt-2">
				{cta && (
					<a href={cta.link}
						class="btn-primary">
						{cta.label} <Icon name={cta.icon} />
					</a>
				)}
				{secondaryCta && (
					<a href={secondaryCta.link}
						class="btn-secondary">
						{secondaryCta.label} <Icon name={secondaryCta.icon} />
					</a>
				)}
			</div>
		)}
	</div>
</section>


<style>
	.hero-section {
		background-image: url('../assets/img/salon-superior.jpeg');
		background-size: cover;
		background-position: 50% 40%;
		background-repeat: no-repeat;
		position: relative;
	}

