---
import { Icon } from 'astro-icon/components';


interface Cta {
	label: string
	link: string
	icon: string
}

type Props = {
	title: string
	subtitle?: string
	cta?: Cta
	secondaryCta?: Cta
}

const { title, subtitle, cta, secondaryCta } = Astro.props
---

<section class="bg-stone-200 min-h-[80vh] flex items-center justify-center px-6 py-20">
	<div class="text-center max-w-2xl mx-auto flex flex-col items-center gap-6">
		<h1 class="text-5xl font-bold tracking-tight text-neutral-900 sm:text-6xl">
			{title}
		</h1>
		{subtitle && (
			<p class="text-lg text-neutral-500 max-w-prose">
				{subtitle}
			</p>
		)}
		{(cta || secondaryCta) && (
			<div class="flex flex-wrap gap-3 justify-center mt-2">
				{cta && (
					<a href={cta.link}
						class="inline-flex items-center gap-1 bg-neutral-900 text-white text-sm font-medium px-6 py-3 rounded-full hover:bg-neutral-700 transition-colors">
						{cta.label} <Icon name={cta.icon} />
					</a>
				)}
				{secondaryCta && (
					<a href={secondaryCta.link}
						class="inline-flex items-center gap-1 border border-neutral-900 text-neutral-900 text-sm font-medium px-6 py-3 rounded-full hover:bg-neutral-900 hover:text-white transition-colors">
						{secondaryCta.label} <Icon name={secondaryCta.icon} />
					</a>
				)}
			</div>
		)}
	</div>
</section>
