---
import { Icon } from 'astro-icon/components';


interface Cta {
	label: string
	link: string
	icon: string
}

type Props = {
	title: string
	subtitle?: string
	cta?: Cta
	secondaryCta?: Cta
}

const { title, subtitle, cta, secondaryCta } = Astro.props
---

<section class="hero-section bg-stone-200 min-h-dvh flex items-center justify-center md:justify-start px-6 md:px-16 lg:px-24 py-20">
	<div class="background-overlay"></div>
	<div class="hero-content text-center md:text-left max-w-2xl mx-auto md:mx-0 flex flex-col items-center md:items-start gap-6 z-10">
		<span class="eyebrow-badge">
			Cocina tradicional · El Bonillo
		</span>
		<h1 class="text-5xl font-display font-bold tracking-tight text-primary sm:text-7xl hero-title">
			{title}
		</h1>
		{subtitle && (
			<p class="text-lg text-text-accent max-w-xl hero-subtitle">
				{subtitle}
			</p>
		)}
		{(cta || secondaryCta) && (
			<div class="flex flex-nowrap gap-3 justify-center md:justify-start mt-2">
				{cta && (
					<a href={cta.link}
						class="btn-primary">
						{cta.label} <Icon name={cta.icon} class="hero-btn-icon" />
					</a>
				)}
				{secondaryCta && (
					<a href={secondaryCta.link}
						class="btn-secondary">
						{secondaryCta.label} <Icon name={secondaryCta.icon} class="hero-btn-icon" />
					</a>
				)}
			</div>
		)}
	</div>
	<div class="scroll-indicator" aria-hidden="true">
		<Icon name="lucide:chevron-down" class="size-5 text-primary/60" />
	</div>
</section>


<style>
	.hero-section {
		background-image: url('/imgs/nuevoherohector1.jpeg');
		background-size: cover;
		background-position: 50% 55%;
		background-repeat: no-repeat;
		position: relative;
	}

	@media (max-width: 768px) {
		.hero-section {
			display: flex;
			flex-direction: column;
			justify-content: start;
			background-image: none;
			background-color: black;
		}

		.hero-section::before {
			content: '';
			position: absolute;
			top: 160px;
			left: 0;
			right: 0;
			bottom: 0;
			background-image: url("/imgs/nuevoherohector1.jpeg");
			background-position: center;
			background-size: cover;
		}

		.hero-content {
			margin-top: 4rem;
			position: relative;
			padding: 1.75rem 1.5rem;
		}

		/* Scrim local: base oscura difuminada tras el texto para asegurar contraste */
		.hero-content::before {
			content: '';
			position: absolute;
			inset: -1rem -1.5rem;
			z-index: -1;
			background: radial-gradient(
				120% 100% at 50% 45%,
				rgba(0, 0, 0, 0.50) 0%,
				rgba(0, 0, 0, 0.35) 45%,
				transparent 80%
			);
			pointer-events: none;
		}
	}

	.background-overlay {
		background: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 0.70) 0%,
			rgba(0, 0, 0, 0.20) 45%,
			rgba(23, 23, 23, 0.80) 82%,
			var(--color-bg) 100%
		);
		height: 100%;
		width: 100%;
		position: absolute;
		top: 0;
		left: 0;
		pointer-events: none;
	}

	.eyebrow-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.65rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-accent);
		border: 1px solid color-mix(in srgb, var(--color-accent-soft) 35%, transparent);
		background: color-mix(in srgb, var(--color-accent) 8%, transparent);
		padding: 0.35rem 0.85rem;
		border-radius: 9999px;
		text-shadow: 0 1px 12px rgba(0, 0, 0, 0.8);
	}

	@media (max-width: 768px) {
		.hero-btn-icon {
			width: 1.25rem;
			height: 1.25rem;
		}
	}

	.hero-title {
		text-shadow: 0 2px 24px rgba(0, 0, 0, 0.85);
	}

	.hero-subtitle {
		text-shadow: 0 2px 20px rgba(0, 0, 0, 0.9);
	}

	.hero-section::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 80px;
		background: linear-gradient(to bottom, transparent, var(--color-bg));
		pointer-events: none;
		z-index: 1;
	}

	.scroll-indicator {
		position: absolute;
		bottom: 2rem;
		left: 50%;
		transform: translateX(-50%);
		animation: scroll-bounce 2s ease-in-out infinite;
		z-index: 2;
	}

	@keyframes scroll-bounce {
		0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.6; }
		50%       { transform: translateX(-50%) translateY(6px); opacity: 1; }
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-indicator { animation: none; }
	}
</style>