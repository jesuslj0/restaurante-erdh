---

import { Icon } from 'astro-icon/components'

interface Link {
	link: string
	name: string
	icon: string
}

type Props = {
	elements: Link[],
}

const { elements } = Astro.props
---

<header class="w-full bg-bg/30 backdrop-blur-sm fixed top-0 z-100">
	<div id="header-inner" class="flex items-center justify-between py-4">


		<span class="text-lg font-semibold font-display text-secondary md:hidden">RDH</span>
		<!-- Logo desktop -->
		<span class="hidden md:block text-lg font-semibold font-display text-secondary">RDH</span>

		<!-- Botón hamburguesa (solo móvil) -->
		<button
			id="menu-open"
			aria-label="Abrir menú"
			aria-expanded="false"
			aria-controls="nav-menu"
			class="md:hidden text-secondary p-2 cursor-pointer"
		>
			<Icon name="lucide:menu" class="size-5" />
		</button>

		<!-- Links de navegación en desktop -->
		<ul class="hidden md:flex md:flex-row md:gap-6">
			{elements.map((element: Link) => (
				<li>
					<a
						href={element.link}
						class="text-secondary text-sm inline-flex gap-2 items-center hover:text-accent-light transition-colors"
					>
						<Icon name={element.icon} class="size-4" />
						{element.name}
					</a>
				</li>
			))}
		</ul>

	</div>
</header>

<nav
	id="nav-menu"
	class="flex fixed inset-0 z-110 flex-col bg-black gap-8 md:hidden translate-x-full transition-transform duration-300 ease-in-out pointer-events-none"
	aria-hidden="true"
>
	<!-- Cabecera del panel -->
	<div id="nav-header" class="flex items-center justify-between">
		<span class="text-base font-display text-primary">El Rincón de Héctor</span>
		<button
			id="menu-close"
			aria-label="Cerrar menú"
			class="text-secondary hover:text-primary transition-colors p-2 cursor-pointer"
		>
			<Icon name="lucide:x" class="size-6" />
		</button>
	</div>

	<hr class="border-secondary/20" />

	<ul class="flex flex-col gap-6">
		{elements.map((element: Link) => (
			<li>
				<a
					href={element.link}
					class="text-primary text-lg inline-flex gap-3 items-center hover:text-secondary transition-colors"
				>
					<Icon name={element.icon} class="size-5" />
					{element.name}
				</a>
			</li>
		))}
	</ul>
</nav>

<style>
	header {
		/* Empuja el contenido bajo la status bar en pantallas edge-to-edge */
		padding-top: env(safe-area-inset-top);
	}

	#header-inner {
		padding-left: max(1.75rem, env(safe-area-inset-left));
		padding-right: max(1.75rem, env(safe-area-inset-right));
	}

	/* Navbar cerrado más compacto en móvil */
	@media (max-width: 768px) {
		#header-inner {
			padding-top: 0.5rem;
			padding-bottom: 0.5rem;
			padding-left: max(1rem, env(safe-area-inset-left));
			padding-right: max(1rem, env(safe-area-inset-right));
		}
	}

	#nav-menu {
		/* El panel fullscreen también respeta las zonas de sistema */
		padding-top: max(1.5rem, env(safe-area-inset-top));
		padding-right: max(1.75rem, env(safe-area-inset-right));
		padding-left: max(1.75rem, env(safe-area-inset-left));
		padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
	}
</style>

<script>
	const openBtn  = document.getElementById('menu-open')!
	const closeBtn = document.getElementById('menu-close')!
	const nav      = document.getElementById('nav-menu')!

	function openMenu() {
		nav.classList.remove('translate-x-full', 'pointer-events-none')
		nav.classList.add('translate-x-0')
		nav.setAttribute('aria-hidden', 'false')
		openBtn.setAttribute('aria-expanded', 'true')
		document.body.style.overflow = 'hidden'
	}

	function closeMenu() {
		nav.classList.remove('translate-x-0')
		nav.classList.add('translate-x-full', 'pointer-events-none')
		nav.setAttribute('aria-hidden', 'true')
		openBtn.setAttribute('aria-expanded', 'false')
		document.body.style.overflow = ''
	}

	openBtn.addEventListener('click', openMenu)
	closeBtn.addEventListener('click', closeMenu)

	// Cierra el panel al pulsar cualquier link del menú móvil
	nav.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', closeMenu)
	})

	document.addEventListener('keydown', (e: KeyboardEvent) => {
		if (e.key === 'Escape') closeMenu()
	})
</script>
