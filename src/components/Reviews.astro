---
import { Icon } from 'astro-icon/components'

interface Review {
	name: string
	text: string
	rating: number
	date?: string
	platform?: 'google' | 'tripadvisor'
}

type Props = {
	eyebrow?: string
	title: string
	subtitle?: string
	averageRating: number
	totalReviews?: number
	reviews: Review[]
}

const { eyebrow, title, subtitle, averageRating, totalReviews, reviews } = Astro.props

const mid = Math.ceil(reviews.length / 2)
const row1 = reviews.slice(0, mid)
const row2 = reviews.slice(mid)

function starArray(rating: number): Array<'full' | 'empty'> {
	return Array.from({ length: 5 }, (_, i) => (rating >= i + 0.5 ? 'full' : 'empty'))
}

const PLATFORM_ICON: Record<string, string> = {
	google: 'simple-icons:google',
	tripadvisor: 'simple-icons:tripadvisor',
}
---

<section id="opiniones" class="bg-bg py-20 overflow-hidden">

	<!-- Cabecera centrada -->
	<div class="max-w-3xl mx-auto px-6 flex flex-col items-center gap-4 text-center mb-12">
		{eyebrow && (
			<span class="text-xs font-semibold uppercase tracking-widest text-accent">
				{eyebrow}
			</span>
		)}
		<h2 class="font-display text-3xl font-bold text-primary sm:text-4xl">{title}</h2>
		{subtitle && (
			<p class="text-text-accent leading-relaxed max-w-prose">{subtitle}</p>
		)}

		<!-- Nota media -->
		<div class="flex flex-col items-center gap-2 mt-2">
			<span class="font-display text-7xl font-bold text-primary leading-none">
				{averageRating.toFixed(1)}
			</span>
			<div class="flex gap-1" role="img" aria-label={`${averageRating} de 5 estrellas`}>
				{starArray(averageRating).map(s => (
					<Icon
						name="lucide:star"
						class={`size-6 ${s === 'full' ? 'text-accent fill-accent' : 'text-secondary/30'}`}
					/>
				))}
			</div>
			{totalReviews && (
				<span class="text-sm text-secondary/50">
					Basado en {totalReviews} opiniones
				</span>
			)}
		</div>
	</div>

	<!-- Fila 1 → desplaza a la izquierda -->
	<div class="marquee-track mb-4">
		<ul class="marquee-row marquee-left flex gap-4 py-1">
			{[...row1, ...row1, ...row1].map((review) => (
				<li class="review-card shrink-0 w-80 bg-primary/[0.04] border border-primary/10 rounded-2xl px-6 py-5 flex flex-col gap-3">
					<div class="flex items-center justify-between">
						<div class="flex gap-0.5">
							{starArray(review.rating).map(s => (
								<Icon
									name="lucide:star"
									class={`size-4 ${s === 'full' ? 'text-accent fill-accent' : 'text-secondary/25'}`}
								/>
							))}
						</div>
						{review.platform && PLATFORM_ICON[review.platform] && (
							<Icon name={PLATFORM_ICON[review.platform]} class="size-4 text-secondary/40" />
						)}
					</div>
					<p class="text-sm text-secondary leading-relaxed line-clamp-3">
						&ldquo;{review.text}&rdquo;
					</p>
					<div class="flex items-center justify-between mt-auto pt-1 border-t border-primary/10">
						<span class="text-xs font-semibold text-primary">{review.name}</span>
						{review.date && (
							<span class="text-xs text-secondary/40">{review.date}</span>
						)}
					</div>
				</li>
			))}
		</ul>
	</div>

	<!-- Fila 2 → desplaza a la derecha -->
	<div class="marquee-track">
		<ul class="marquee-row marquee-right flex gap-4 py-1">
			{[...row2, ...row2, ...row2].map((review) => (
				<li class="review-card shrink-0 w-80 bg-primary/[0.04] border border-primary/10 rounded-2xl px-6 py-5 flex flex-col gap-3">
					<div class="flex items-center justify-between">
						<div class="flex gap-0.5">
							{starArray(review.rating).map(s => (
								<Icon
									name="lucide:star"
									class={`size-4 ${s === 'full' ? 'text-accent fill-accent' : 'text-secondary/25'}`}
								/>
							))}
						</div>
						{review.platform && PLATFORM_ICON[review.platform] && (
							<Icon name={PLATFORM_ICON[review.platform]} class="size-4 text-secondary/40" />
						)}
					</div>
					<p class="text-sm text-secondary leading-relaxed line-clamp-3">
						&ldquo;{review.text}&rdquo;
					</p>
					<div class="flex items-center justify-between mt-auto pt-1 border-t border-primary/10">
						<span class="text-xs font-semibold text-primary">{review.name}</span>
						{review.date && (
							<span class="text-xs text-secondary/40">{review.date}</span>
						)}
					</div>
				</li>
			))}
		</ul>
	</div>

</section>

<style>
	.marquee-track {
		overflow: hidden;
		mask-image: linear-gradient(
			to right,
			transparent,
			black 12%,
			black 88%,
			transparent
		);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent,
			black 12%,
			black 88%,
			transparent
		);
	}

	.marquee-row {
		width: max-content;
		will-change: transform;
	}

	@media (prefers-reduced-motion: no-preference) {
		.marquee-left {
			animation: scroll-left 50s linear infinite;
		}
		.marquee-right {
			animation: scroll-right 50s linear infinite;
		}
	}

	@keyframes scroll-left {
		from { transform: translateX(0); }
		to   { transform: translateX(-33.333%); }
	}

	@keyframes scroll-right {
		from { transform: translateX(-33.333%); }
		to   { transform: translateX(0); }
	}

	/* Pausa al hover */
	.marquee-track:hover .marquee-row {
		animation-play-state: paused;
	}
</style>
