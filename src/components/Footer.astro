---
import { Icon } from 'astro-icon/components'


interface Link {
	link: string
	name: string
}

interface SocialLink {
	link: string
	name: string
	icon: string
	username: string
}

interface FooterProps {
	elements: Link[]
	socialElements: SocialLink[]
	restaurantName: string
	year?: number
}

const { elements, socialElements, restaurantName, year = new Date().getFullYear() } = Astro.props
---

<footer class="bg-neutral-900 text-neutral-300 px-6 py-10 mt-auto">
	<div class="max-w-4xl mx-auto flex flex-col items-center gap-6 lg:flex-row lg:justify-between lg:items-start">
		<nav>
			<ul class="flex gap-6 flex-wrap justify-center lg:justify-start">
				{elements.map((element: Link) => (
					<li>
						<a href={element.link} class="hover:text-white transition-colors text-sm">
							{element.name}
						</a>
					</li>
				))}
			</ul>
		</nav>
		<div class="flex flex-col items-center gap-3 lg:items-end">
			<p class="text-xs font-semibold uppercase tracking-widest text-neutral-500">Síguenos en redes</p>
			<ul class="flex flex-col gap-5 md:flex-row">
				{socialElements.map((social: SocialLink) => (
					<li>
						<a href={social.link} target="_blank" rel="noopener noreferrer" aria-label={social.name}
							class="flex items-center gap-1.5 text-sm hover:text-white transition-colors">
							<Icon name={social.icon} class="size-4" />
							@{social.username}
						</a>
					</li>
				))}
			</ul>
		</div>
	</div>
	<p class="text-xs text-neutral-500 text-center mt-6 max-w-4xl mx-auto">&copy; {year} {restaurantName}. Todos los derechos reservados.</p>
</footer>
