---
interface Props {
	videoSrc?: string;
}

const { videoSrc = "/videos/burguer171717-scrub.mp4" } = Astro.props;

const ingredients = [
	"Disco de ternera manchega a la parrilla",
	"Queso semicurado artesano fundido",
	"Lomo de orza con sabor de antaño",
	"Picadillo de chorizo en la base",
	"Alioli casero hecho en casa",
	"Pan rústico de miga prieta",
];
---

<section id="burger-del-mes" class="relative h-[250vh] lg:h-[300vh] bg-bg">
	<div class="sticky top-0 h-screen overflow-hidden flex flex-col lg:grid lg:grid-cols-[1fr_auto_1fr]">

		<!-- ── COLUMNA IZQUIERDA: concepto (solo desktop) ── -->
		<div class="hidden lg:flex flex-col items-end text-right justify-center gap-6 px-12 xl:px-16">
			<span class="text-xs font-semibold uppercase tracking-widest text-accent">
				Burguer del mes
			</span>
			<h2 class="text-4xl xl:text-5xl font-bold text-primary leading-tight">
				La Manchega
			</h2>
			<p class="text-secondary leading-relaxed max-w-sm">
				Este verano, los campos de La Mancha llegan a tu mesa en una sola mordida.
				Hemos seleccionado a mano cada ingrediente para crear una burguer que huele
				a tierra, sabe a tradición y te deja sin palabras: jugosa por dentro,
				dorada por fuera, con ese carácter artesano que solo encontrarás aquí.
			</p>
		</div>

		<!-- ── COLUMNA CENTRAL: título móvil + vídeo ── -->
		<div class="flex flex-col items-center justify-start lg:justify-center h-full">

			<!-- Título solo en móvil -->
			<div class="lg:hidden w-full pt-24 pb-3 px-6 text-center flex flex-col gap-1 shrink-0">
				<span class="text-xs font-semibold uppercase tracking-widest text-accent">
					Burguer del mes
				</span>
				<h2 class="text-3xl font-bold text-primary font-display mb-10">La Manchega</h2>
			</div>

			<video
				id="burger-video"
				class="h-auto max-h-[68vh] lg:max-h-[92vh] w-auto max-w-full"
				muted
				playsinline
				preload="auto"
			>
				<source src={videoSrc} type="video/mp4" />
			</video>
		</div>

		<!-- ── COLUMNA DERECHA: ingredientes + CTA (solo desktop) ── -->
		<div class="hidden lg:flex flex-col justify-center gap-8 px-12 xl:px-16">

			<div class="flex flex-col gap-3">
				<span class="text-xs font-semibold uppercase tracking-widest text-secondary/60">
					Ingredientes
				</span>
				<ul class="flex flex-col gap-2.5">
					{ingredients.map((item) => (
						<li class="flex items-center gap-3">
							<span class="flex size-6 shrink-0 items-center justify-center rounded-md bg-accent/15 text-accent">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
									<polyline points="20 6 9 17 4 12"/>
								</svg>
							</span>
							<span class="text-sm text-secondary leading-snug">{item}</span>
						</li>
					))}
				</ul>
			</div>

			<div class="flex flex-col gap-3 pt-6 border-t border-primary/10">
				<p class="text-lg font-bold text-primary">
					¿La has probado ya?
				</p>
				<p class="text-sm text-secondary/70 leading-snug">
					¡No dudes en hacerlo! Llámanos y pruébala hoy mismo.
				</p>
				<div>
					<a href="/#reservas" class="btn-primary">
						<span class="cycle-text" data-words='["Quiero", "Probarla"]'>Quiero</span>
	</a>
				</div>
			</div>

		</div>

	</div>
</section>

<!-- ── MÓVIL ONLY: descripción + ingredientes + CTA ── -->
<div class="lg:hidden bg-bg px-6 py-12 flex flex-col gap-10">

	<p class="text-secondary leading-relaxed">
		Este verano, los campos de La Mancha llegan a tu mesa en una sola mordida.
		Hemos seleccionado a mano cada ingrediente para crear una burguer que huele
		a tierra, sabe a tradición y te deja sin palabras: jugosa por dentro,
		dorada por fuera, con ese carácter artesano que solo encontrarás aquí.
	</p>

	<div class="flex flex-col gap-3">
		<span class="text-xs font-semibold uppercase tracking-widest text-secondary/60">
			Ingredientes
		</span>
		<ul class="flex flex-col gap-2.5">
			{ingredients.map((item) => (
				<li class="flex items-center gap-3">
					<span class="flex size-6 shrink-0 items-center justify-center rounded-md bg-accent/15 text-accent">
						<svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="20 6 9 17 4 12"/>
						</svg>
					</span>
					<span class="text-sm text-secondary leading-snug">{item}</span>
				</li>
			))}
		</ul>
	</div>

	<div class="flex flex-col gap-3 pt-6 border-t border-primary/10">
		<p class="text-lg font-bold text-primary">
			¿La has probado ya?
		</p>
		<p class="text-sm text-secondary/70 leading-snug">
			¡No dudes en hacerlo! Llámanos y pruébala hoy mismo.
		</p>
		<div>
			<a href="/#reservas" class="btn-primary">
				Quiero probarla
			</a>
		</div>
	</div>

</div>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const section = document.getElementById("burger-del-mes");
	const video = document.getElementById("burger-video") as HTMLVideoElement | null;

	if (section && video) {
		const init = () => {
			video.pause();
			video.play().then(() => video.pause()).catch(() => {});

			const state = { t: 0 };
			let queuedTime: number | null = null;
			let seeking = false;

			// Espera al frame pintado (rVFC) antes de pedir el siguiente seek;
			// así nunca se encolan más seeks de los que el decoder puede servir.
			const applySeek = () => {
				if (queuedTime === null) { seeking = false; return; }
				const t = queuedTime;
				queuedTime = null;
				video.currentTime = t;
				if ("requestVideoFrameCallback" in video) {
					(video as any).requestVideoFrameCallback(applySeek);
				} else {
					requestAnimationFrame(applySeek);
				}
			};

			gsap.to(state, {
				t: video.duration || 1,
				ease: "none",
				scrollTrigger: {
					trigger: section,
					start: "top top",
					end: "bottom bottom",
					scrub: true,
					invalidateOnRefresh: true,
				},
				onUpdate: () => {
					queuedTime = state.t;
					if (!seeking) {
						seeking = true;
						applySeek();
					}
				},
			});
		};

		if (video.readyState >= 1) init();
		else video.addEventListener("loadedmetadata", init, { once: true });

		// Red de seguridad inofensiva: cuando todos los recursos hayan cargado,
		// refresca posiciones por si Lenis o el layout aún no estaban listos.
		if (document.readyState === "complete") {
			ScrollTrigger.refresh();
		} else {
			window.addEventListener("load", () => ScrollTrigger.refresh(), { once: true });
		}
	}
</script>

<script>
	// Alterna el texto de los botones .cycle-text con fade + translate + blur,
	// replicando la animación del componente CycleStatusButton sin React ni framer-motion.
	document.querySelectorAll<HTMLElement>('.cycle-text').forEach((el) => {
		const raw = el.getAttribute('data-words');
		if (!raw) return;
		let words: string[] = [];
		try { words = JSON.parse(raw); } catch { return; }
		if (words.length < 2) return;

		let i = 0;
		el.textContent = words[0];

		const visible = { opacity: 1, transform: 'translateY(0)', filter: 'blur(0px)' };
		const goneUp = { opacity: 0, transform: 'translateY(-10px)', filter: 'blur(10px)' };
		const comeFromBelow = { opacity: 0, transform: 'translateY(10px)', filter: 'blur(10px)' };
		const opts: KeyframeAnimationOptions = { duration: 300, easing: 'ease', fill: 'forwards' };

		setInterval(() => {
			el.animate([visible, goneUp], opts).finished.then(() => {
				i = (i + 1) % words.length;
				el.textContent = words[i];
				el.animate([comeFromBelow, visible], opts);
			});
		}, 2000);
	});
</script>

<style>
	.cycle-text {
		display: inline-block;
		min-width: 4.5rem;
		text-align: center;
	}

	#burger-video {
		-webkit-mask-image: linear-gradient(
			to right,
			transparent 0%,
			black 14%,
			black 86%,
			transparent 100%
		);
		mask-image: linear-gradient(
			to right,
			transparent 0%,
			black 14%,
			black 86%,
			transparent 100%
		);
	}
</style>
